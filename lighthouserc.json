{
  "ci": {
    "collect": {
      "url": [
        "https://v2.mon-pilates.bzh/",
        "https://v2.mon-pilates.bzh/cours",
        "https://v2.mon-pilates.bzh/cours/mat",
        "https://v2.mon-pilates.bzh/planning",
        "https://v2.mon-pilates.bzh/tarifs",
        "https://v2.mon-pilates.bzh/contact",
        "https://v2.mon-pilates.bzh/equipe",
        "https://v2.mon-pilates.bzh/premiere-visite",
        "https://v2.mon-pilates.bzh/blog",
        "https://v2.mon-pilates.bzh/blog/5-exercices-pilates-mal-de-dos"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new --disable-gpu",
        "skipAudits": ["uses-http2"],
        "maxWaitForLoad": 45000
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1800 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }],
        "speed-index": ["warn", { "maxNumericValue": 3400 }],
        "interactive": ["warn", { "maxNumericValue": 3800 }],
        "uses-responsive-images": "warn",
        "uses-optimized-images": "warn",
        "uses-text-compression": "warn",
        "unused-javascript": "warn",
        "unused-css-rules": "warn",
        "render-blocking-resources": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
