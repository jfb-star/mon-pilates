{
  "ci": {
    "collect": {
      "url": [
        "https://v2.mon-pilates.bzh/",
        "https://v2.mon-pilates.bzh/cours",
        "https://v2.mon-pilates.bzh/planning",
        "https://v2.mon-pilates.bzh/tarifs",
        "https://v2.mon-pilates.bzh/contact",
        "https://v2.mon-pilates.bzh/connexion"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new --disable-gpu --ignore-certificate-errors",
        "skipAudits": ["uses-http2"],
        "maxWaitForLoad": 45000
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.90 }],
        "categories:performance": ["warn", { "minScore": 0.80 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-prod"
    }
  }
}
