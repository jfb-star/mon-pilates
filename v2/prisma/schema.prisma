generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("USER")
  referralCode String?  @unique
  referredBy   String?  // userId of referrer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instructor        Instructor?
  bookings          Booking[]
  payments          Payment[]
  courseCards        CourseCard[]
  subscriptions     Subscription[]
  blogPosts         BlogPost[]
  redeemedGiftCards GiftCard[]     @relation("RedeemedBy")
  notifications     Notification[]
  reviews           Review[]
  subscriber        Subscriber?
}

model Instructor {
  id             String  @id @default(cuid())
  userId         String  @unique
  bio            String?
  photo          String?
  certifications String?
  specialties    String  @default("[]")
  slug           String  @unique

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules Schedule[]
  sessions  Session[]
}

model CourseType {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  description      String?
  shortDescription String?
  duration         Int
  level            String  @default("ALL_LEVELS")
  intensity        Int     @default(3)
  maxParticipants  Int
  image            String?
  color            String?
  icon             String?
  benefits         String  @default("[]")
  equipment        String  @default("[]")

  schedules Schedule[]
  sessions  Session[]
  reviews   Review[]
}

model Schedule {
  id              String    @id @default(cuid())
  courseTypeId     String
  instructorId    String
  dayOfWeek       Int
  startTime       String
  endTime         String
  isRecurring     Boolean   @default(true)
  startDate       DateTime
  endDate         DateTime?
  maxParticipants Int?

  courseType  CourseType @relation(fields: [courseTypeId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  sessions   Session[]
}

model Session {
  id                  String @id @default(cuid())
  scheduleId          String
  courseTypeId         String
  instructorId        String
  date                DateTime
  startTime           String
  endTime             String
  status              String @default("SCHEDULED")
  maxParticipants     Int
  currentParticipants Int    @default(0)
  notes               String?

  schedule   Schedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  courseType CourseType @relation(fields: [courseTypeId], references: [id], onDelete: Cascade)
  instructor Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  bookings   Booking[]
}

model Booking {
  id            String    @id @default(cuid())
  userId        String
  sessionId     String
  status        String    @default("CONFIRMED")
  paymentMethod String    @default("UNIT")
  paymentStatus String    @default("PAID")
  createdAt     DateTime  @default(now())
  cancelledAt   DateTime?
  paidAt        DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Payment {
  id                      String   @id @default(cuid())
  userId                  String
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  amount                  Int
  currency                String   @default("eur")
  status                  String   @default("PENDING")
  type                    String
  metadata                String?
  createdAt               DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseCard CourseCard?
}

model CourseCard {
  id                String   @id @default(cuid())
  userId            String
  paymentId         String   @unique
  type              String
  totalSessions     Int
  remainingSessions Int
  purchasedAt       DateTime @default(now())
  expiresAt         DateTime

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  stripeSubscriptionId String?
  stripePriceId        String?
  status               String   @default("ACTIVE")
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  maxSessionsPerMonth  Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GiftCard {
  id                String    @id @default(cuid())
  code              String    @unique
  purchaserEmail    String
  recipientEmail    String
  recipientName     String?
  message           String?
  amount            Int?
  sessions          Int?
  remainingAmount   Int?
  remainingSessions Int?
  status            String    @default("ACTIVE")
  purchasedAt       DateTime  @default(now())
  expiresAt         DateTime
  redeemedAt        DateTime?
  redeemedByUserId  String?

  redeemedBy User? @relation("RedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  authorId    String
  tags        String    @default("[]")

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "BOOKING_CONFIRMED", "WAITLIST_PROMOTED", "CARD_EXPIRING", "REFERRAL_CREDIT", "SYSTEM"
  title     String
  message   String
  read      Boolean  @default(false)
  data      String?  // JSON metadata (link, etc.)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  subject   String
  message   String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model Review {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseTypeId  String
  courseType    CourseType @relation(fields: [courseTypeId], references: [id], onDelete: Cascade)
  rating       Int
  comment      String?
  createdAt    DateTime   @default(now())

  @@unique([userId, courseTypeId])
}

// Transactional email templates (booking confirm, reset password, etc.)
// htmlCompiled is generated from mjmlSource on save; variables is a JSON array
// of variable names usable in {{mustache}} substitution.
model EmailTemplate {
  id            String   @id @default(cuid())
  key           String   @unique // e.g. "booking_confirm", "reset_password"
  name          String
  subject       String
  mjmlSource    String   // editable source (MJML or HTML)
  htmlCompiled  String   // rendered HTML cached at save time
  variables     String   @default("[]") // JSON array of variable names
  updatedAt     DateTime @updatedAt
  updatedBy     String?  // userId of last admin editor
  createdAt     DateTime @default(now())

  logs EmailLog[]
}

// Marketing campaigns — orchestrated via Resend Broadcasts API.
// audienceFilter is a JSON object describing segment criteria (tags, etc).
// stats is a JSON snapshot of Resend stats (opens, clicks, bounces).
model EmailCampaign {
  id                 String    @id @default(cuid())
  name               String
  subject            String
  mjmlSource         String
  htmlCompiled       String
  status             String    @default("DRAFT") // DRAFT | SCHEDULED | SENDING | SENT | FAILED
  resendBroadcastId  String?   @unique
  resendAudienceId   String?   // target audience id in Resend
  audienceFilter     String    @default("{}") // JSON — reserved for in-app segment refinement
  scheduledAt        DateTime?
  sentAt             DateTime?
  stats              String    @default("{}") // JSON
  createdBy          String?   // userId
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// Marketing subscribers (RGPD: explicit consent required).
// Linked to User when the subscriber has an account; email is the source of truth
// for unauthenticated newsletter signups. resendContactId mirrors the Resend Audience contact.
model Subscriber {
  id                String    @id @default(cuid())
  email             String    @unique
  userId            String?   @unique
  consentAt         DateTime  @default(now())
  unsubscribedAt    DateTime?
  resendContactId   String?
  resendAudienceId  String?   // audience the contact was pushed to
  tags              String    @default("[]") // JSON array
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// Hashed password-reset tokens. The raw token is mailed to the user; only the
// sha256 hash is persisted so a DB leak can't be turned into a takeover.
model PasswordResetToken {
  tokenHash String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Stripe webhook event ledger for idempotency. Stripe retries at-least-once,
// so we guard every event handler against duplicate processing.
model StripeWebhookEvent {
  eventId     String   @id
  type        String
  processedAt DateTime @default(now())
}

// Transactional send log — every Resend call leaves a trace here for debugging
// and the /admin/emails/logs UI.
model EmailLog {
  id           String   @id @default(cuid())
  templateKey  String?
  toEmail      String
  subject      String
  providerId   String?  // Resend message id
  status       String   @default("SENT") // SENT | FAILED | BOUNCED
  error        String?
  sentAt       DateTime @default(now())

  template EmailTemplate? @relation(fields: [templateKey], references: [key], onDelete: SetNull)

  @@index([toEmail])
  @@index([sentAt])
}
