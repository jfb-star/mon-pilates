{
  "name": "mon-pilates-v2",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3456 --hostname 0.0.0.0 --turbopack",
    "build": "prisma generate && prisma db push --accept-data-loss --skip-generate && next build",
    "build:migrate": "prisma generate && prisma migrate deploy && next build",
    "db:push": "prisma db push",
    "start": "next start",
    "tunnel": "npx localtunnel --port 3456",
    "seed": "npx tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --dir src",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.4",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.49.0",
    "@stripe/stripe-js": "^9.1.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.8.0",
    "next": "^16.2.3",
    "next-auth": "5.0.0-beta.30",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "resend": "^6.12.0",
    "stripe": "^22.0.1",
    "zod": "^4.3.6"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.19.39",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^3.2.4",
    "postcss": "^8.5.9",
    "prisma": "^5.22.0",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.2.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  }
}
