{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3456/",
        "http://localhost:3456/cours",
        "http://localhost:3456/planning",
        "http://localhost:3456/tarifs",
        "http://localhost:3456/contact"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage --headless=new --disable-gpu",
        "skipAudits": ["uses-http2"],
        "maxWaitForLoad": 45000
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.90 }],
        "categories:performance": ["warn", { "minScore": 0.80 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci-local"
    }
  }
}
